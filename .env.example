# Langfuse configuration (use Code Engine Secrets for API keys)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=YOUR_LANGFUSE_PROJECT_ID
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME

# COS is mandatory. The bucket must already exist.
COS_ENDPOINT=https://s3.eu-de.cloud-object-storage.appdomain.cloud
COS_API_KEY=REPLACE_ME
COS_SERVICE_INSTANCE_ID=YOUR_COS_RESOURCE_INSTANCE_CRN
COS_BUCKET=YOUR_EXISTING_BUCKET
COS_OBJECT_KEY=inventario_langfuse.json

# Inventory extraction options
INVENTORY_DAYS=30
INVENTORY_PAGE_SIZE=500
INVENTORY_INSPECT_IO=false
INVENTORY_DRY_RUN=false
INVENTORY_PRINT_JSON=false
